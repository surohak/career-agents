{
  "person": {
    "name": "<Full Name>",
    "linkedin_url": "https://www.linkedin.com/in/<handle>/",
    "location": "<City, Country>",
    "email_public": false,
    "country": "<Country>",
    "timezone": "<UTC offset, e.g. UTC+4>",
    "work_authorization": [
      "<regions or countries you may work in without sponsorship>"
    ],
    "can_relocate": false
  },
  "cv": {
    "adapter": "markdown",
    "source": "profile/cv-canonical.md",
    "output": "out/cv.pdf",
    "canva_design_id": "",
    "docx_path": ""
  },
  "site": {
    "url": "",
    "repo": "",
    "content_paths": [],
    "chatbot_knowledge_base": ""
  },
  "target": {
    "role": "<Target job title>",
    "keywords": [
      "<keyword 1>",
      "<keyword 2>"
    ],
    "markets": [
      "remote",
      "<country>"
    ],
    "engagement": "employee"
  },
  "rules": {
    "no_em_dash": true,
    "no_invented_metrics": true,
    "no_open_to_work_phrases": true,
    "never_autopost": true,
    "years_of_experience_in_copy": false
  },
  "search": {
    "keywords": [
      "<Job title 1>",
      "<Job title 2>"
    ],
    "location": "Worldwide",
    "work_type": "remote",
    "experience_level": "mid_senior",
    "max_applicants": 10
  },
  "automation": {
    "mode": "assisted",
    "browser": "claude-in-chrome",
    "approvals": {
      "linkedin_edit": false,
      "post": false,
      "comment": false,
      "connect": true,
      "message": true,
      "apply": true,
      "cv_commit": false,
      "site_push": false
    }
  },
  "schedule": {
    "enabled": false,
    "daily_at": "08:00",
    "weekly_review_day": "monday",
    "jobs": [
      "job-scan",
      "application-tracker",
      "dashboard"
    ],
    "weekly": [
      "weekly-review",
      "rejection-review",
      "dashboard"
    ],
    "runner": "scheduled-tasks"
  },
  "notify": {
    "channel": "file",
    "target": "out/digests.md",
    "on": [
      "run_end",
      "reply_received",
      "interview_scheduled",
      "blocked"
    ],
    "quiet_hours": [
      "22:00",
      "07:00"
    ]
  }
}
